# Geekyard Production Environment Variables
# Copy this file to .env.production and fill in the values.
# NEVER commit .env.production to git.

# -- PostgreSQL --
# POSTGRESQL_HOST: Docker 네트워크 내 서비스명 (변경 불필요)
POSTGRESQL_HOST=postgres
POSTGRESQL_DATABASE=geekyard
POSTGRESQL_USERNAME=geekyard_user
POSTGRESQL_PASSWORD=<strong-password>

# -- Redis --
# REDIS_HOST: Docker 네트워크 내 서비스명 (변경 불필요)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<strong-password>

# -- MongoDB --
# MONGO_USERNAME/PASSWORD: MongoDB 컨테이너 초기 계정 생성에 사용됨
# MONGODB_URI: 앱 연결 문자열 (mongodb 서비스명 사용, authSource=admin 필수)
MONGO_USERNAME=geekyard_user
MONGO_PASSWORD=<strong-password>
MONGO_DB=geekyard
MONGODB_URI=mongodb://geekyard_user:<strong-password>@mongodb:27017/geekyard?authSource=admin

# -- JWT --
# 256비트 이상 랜덤 문자열: openssl rand -base64 64
JWT_SECRET=<256bit-random-string>

# -- Mail (Gmail App Password) --
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<gmail-address>
MAIL_PASSWORD=<gmail-app-password>

# -- OAuth2 --
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
KAKAO_CLIENT_ID=<kakao-rest-api-key>
KAKAO_CLIENT_SECRET=<kakao-client-secret>
NAVER_CLIENT_ID=<naver-client-id>
NAVER_CLIENT_SECRET=<naver-client-secret>

# -- App URLs --
APP_BASE_URL=https://api.geekyard.soaengry.com
FRONTEND_URL=https://geekyard.soaengry.com

# -- AWS S3 --
AWS_S3_BUCKET=<bucket-name>
AWS_S3_REGION=ap-northeast-2
AWS_ACCESS_KEY=<iam-access-key>
AWS_SECRET_KEY=<iam-secret-key>

# -- Recommendation (Python 배치) --
# Python 스크립트 미사용 시 false 유지
RECOMMENDATION_ENABLED=false
# RECOMMENDATION_PYTHON_PATH=python3
# RECOMMENDATION_SCRIPTS_DIR=/opt/geekyard/scripts
